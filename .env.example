# Required — set a real password before deploying. The app warns at startup
# if this is left unset or still 'changeme'.
ADMIN_PASSWORD=
SECRET_KEY=generate-a-random-string-here

# Optional - for Google Books fallback
GOOGLE_BOOKS_API_KEY=

# Optional customization
LIBRARY_NAME=Our Bookshelf

# Optional — database passwords. Defaults are fine because the database is
# only reachable inside the compose network. Only applied on first start
# (before the dolt-data volume exists).
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Internal (change if ports conflict)
HOST_PORT=8484
